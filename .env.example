# Gemini API Key (Required for backend / Cloudflare Worker)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Frontend API Base URL (leave empty or /api for local Express server / Vite proxy,
# or point to your deployed Cloudflare Worker URL e.g. https://speechcraft-worker.yourname.workers.dev)
VITE_API_BASE_URL=

# Port for local Express server
PORT=3000
